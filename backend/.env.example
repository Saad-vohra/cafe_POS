# Server port (Render / local)
PORT=5000

# MongoDB Atlas connection string.
# Use a SEPARATE database for local development/testing (e.g. .../Cafe_POS_dev),
# never the restaurant's live database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT secret key for token authentication — a long random string (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

NODE_ENV=development

# Restaurant timezone for daily reports (Render runs in UTC)
TZ=Asia/Kolkata

# Allowed frontend URL(s) for CORS, comma-separated. Requests from any other website are refused.
FRONTEND_URL=http://localhost:3000
